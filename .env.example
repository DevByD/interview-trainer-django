# Core Security & Debug
SECRET_KEY=django-insecure-change-me-for-production-environment-key-xyz
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,.vercel.app
SITE_DOMAIN=localhost:8000

# Database (Local MySQL for Development)
DB_NAME=interview_trainer
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

# Database URL (Optional: Cloud / Production MySQL or PostgreSQL connection string)
# DATABASE_URL=mysql://user:password@host:3306/dbname

# Firebase / Firestore Configuration (Production Cloud Database & Repository Layer)
# Option 1: Explicit Credentials (Recommended for Vercel)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Option 2: Base64 Encoded Service Account JSON
# FIREBASE_SERVICE_ACCOUNT_KEY_BASE64=eyJ0eXBlIjogInNlcnZpY2VfYWNjb3VudCIsICJwcm9qZWN0X2lkIjogIi4uLiJ9

# Option 3: Local Service Account JSON File Path (Local development only)
# FIREBASE_SERVICE_ACCOUNT_PATH=serviceAccountKey.json

# Email / SMTP Configuration (ConsoleBackend default for development)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USER=your-email@example.com
EMAIL_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=noreply@interviewtrainer.local

# Scheduled Automation / Cron Secret
CRON_SECRET_KEY=generate-a-secure-random-secret-for-cron-triggers
