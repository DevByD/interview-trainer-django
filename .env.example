# Core Security & Debug
SECRET_KEY=django-insecure-change-me-for-production-environment-key-xyz
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,.vercel.app
SITE_DOMAIN=localhost:8000
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,https://*.vercel.app

# AI Question Generation (Gemini 2.5 API Key)
GEMINI_API_KEY=your-gemini-api-key-here

# Database (Local SQLite by default or MySQL)
DB_NAME=interview_trainer
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

# Database URL (Optional: Cloud / Production MySQL or PostgreSQL connection string)
# DATABASE_URL=mysql://user:password@host:3306/dbname

# Email / SMTP Configuration (ConsoleBackend default for development)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USER=your-email@example.com
EMAIL_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=noreply@interviewtrainer.local

# Scheduled Automation / Cron Secret
CRON_SECRET_KEY=generate-a-secure-random-secret-for-cron-triggers

# Production SSL & Security Settings (Enabled when DEBUG=False)
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# SECURE_HSTS_PRELOAD=True
